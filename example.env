# Set your environment variables here
# Afterwards, rename this file to ".env"
# PostgreSQL
# Username for the PostgreSQL database
DB_USER=postgres
# Password for the PostgreSQL database
DB_PASSWORD=rescuemate
# Name of the database that gets created
DB_NAME=hamburgdatamap
# PostgreSQL port, keep this as 5432 if you don't know what you're doing
DB_PORT=5432

# When true, the backend serves pre-seeded demo reports instead of fetching
# real posts, and exposes a /demo/reset endpoint to trickle them in. Leave
# false for normal operation.
DEMO_MODE=False

# pgAdmin (optional)
# Login email for the pgAdmin web UI
PGADMIN_DEFAULT_EMAIL=user@example.com
# Login password for the pgAdmin web UI
PGADMIN_DEFAULT_PASSWORD=examplePassword

# Comma-separated list of RescueMate KG SPARQL endpoints. These are failover
# peers, not replicas -- the map reads from ALL of them and unions the results.
SPARQL_ENDPOINTS="https://node-1.net.uhh.rescue-mate.de/sparql,https://node-2.net.uhh.rescue-mate.de/sparql"

# SameSite policy of the login cookie. Use "none" when the map is embedded as
# an iframe on another domain (requires HTTPS); leave "lax" otherwise.
COOKIE_SAMESITE=none

# Bootstrap admin username, created on first startup if it doesn't exist yet
DEFAULT_ADMIN_USER=admin
# Bootstrap admin password -- change this after first login
DEFAULT_ADMIN_PASSWORD=changeme
# RescueMate Keycloak credentials (ask the project team)
USERNAME=your-username
PASSWORD=your-password