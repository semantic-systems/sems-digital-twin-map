# Set your environment variables here
# Afterwards, rename this file to ".env"
# PostgreSQL
DB_USER=postgres
DB_PASSWORD=rescuemate
DB_NAME=hamburgdatamap
DB_PORT=5432

# pgAdmin (optional)
PGADMIN_DEFAULT_EMAIL=user@example.com
PGADMIN_DEFAULT_PASSWORD=examplePassword

SPARQL_ENDPOINT="https://node-1.net.uhh.rescue-mate.de/sparql"

# Free-text Query panel: the map calls this OpenAI-compatible LLM directly to turn
# a query into crisis-taxonomy labels. Leave QUERY_LLM_URL empty to disable the
# feature (the Query tab stays hidden). The API key is forwarded as the `x-bf-vk`
# header (BrainFrame proxy) and as a Bearer token.
# QUERY_LLM_URL=https://<brainframe-proxy>/v1
# QUERY_LLM_API_KEY=your-bfk-virtual-key
# QUERY_LLM_MODEL=google/gemma-4-31B-it

# Nominatim instance for OSM location search (defaults to public instance)
# NOMINATIM_URL=https://nominatim.openstreetmap.org

# Auth session cookie. Set to true in production so the login cookie is only sent
# over HTTPS (requires the app to be served behind TLS — e.g. a reverse proxy in
# front of the frontend container). Leave false for local http development.
COOKIE_SECURE=false

# Bootstrap admin account, created on first startup if it doesn't exist yet.
# Only ever CREATED (never reset), so a password you change in-app survives
# restarts. CHANGE THE PASSWORD after first login. Leave the password blank to
# skip bootstrapping (then provision via: python scripts/create_user.py x --admin).
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=changeme
# RescueMate Keycloak credentials (ask the project team)
USERNAME=your-username
PASSWORD=your-password

